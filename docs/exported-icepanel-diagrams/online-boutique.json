  "flows": [
    {
      "id": "flow-user-purchase",
      "architectureId": "arch-icepanel-boutique",
      "name": "User purchase flows",
      "description": "Complete 27-step purchase sequence with alternate success, failed, and timeout branches as depicted in IcePanel.",
      "type": "user_journey",
      "actorId": "obj-customers",
      "persona": "Customer",
      "steps": [
        {
          "id": "step-1",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-cust-self",
          "stepIndex": 0,
          "note": "User clicks checkout and pay",
          "actorAction": "Clicks Checkout & Pay button",
          "userIntent": "Complete shopping basket checkout"
        },
        {
          "id": "step-2",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-cust-front",
          "stepIndex": 1,
          "note": "User requests to make a purchase via Real user traffic",
          "actorAction": "Submits order request",
          "endpoint": "/api/checkout",
          "httpMethod": "POST",
          "statusCode": 200
        },
        {
          "id": "step-3",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-front-checkout",
          "stepIndex": 2,
          "note": "Initiate checkout process via Start checkout process for product",
          "endpoint": "hipstershop.CheckoutService/PlaceOrder",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-4",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-catalog",
          "stepIndex": 3,
          "note": "Check products are in stock and reserve via Request price of product",
          "endpoint": "hipstershop.ProductCatalogService/GetProduct",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-5",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-catalog-checkout",
          "stepIndex": 4,
          "note": "Send confirmation of reservation via Request price of product",
          "statusCode": 200
        },
        {
          "id": "step-6",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-cart",
          "stepIndex": 5,
          "note": "Fetches the users cart details via Get's in stock items in cart from",
          "endpoint": "hipstershop.CartService/GetCart",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-7",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-cart-cache",
          "stepIndex": 6,
          "note": "Checks user cached cart via Checks items from",
          "endpoint": "HGETALL cart:{userId}",
          "httpMethod": "TCP"
        },
        {
          "id": "step-8",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-cache-cart",
          "stepIndex": 7,
          "note": "Returns cached items via Checks items from",
          "statusCode": 200
        },
        {
          "id": "step-9",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-cart-checkout",
          "stepIndex": 8,
          "note": "Returns cached items via Get's in stock items in cart from",
          "statusCode": 200
        },
        {
          "id": "step-10",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-shipping",
          "stepIndex": 9,
          "note": "Get shipping details via Send shipping instructions",
          "endpoint": "hipstershop.ShippingService/GetQuote",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-11",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-shipping-checkout",
          "stepIndex": 10,
          "note": "Returns shipping details via Send shipping instructions",
          "statusCode": 200
        },
        {
          "id": "step-12",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-payment",
          "stepIndex": 11,
          "note": "Send payment to process via Make payment after checkout",
          "endpoint": "hipstershop.PaymentService/Charge",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-13",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-currency",
          "stepIndex": 12,
          "note": "Fetch currency exchange of local currency via Fetch latest exchange rate for payment",
          "endpoint": "GET /latest?base=USD",
          "httpMethod": "HTTPS"
        },
        {
          "id": "step-14",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-currency-payment",
          "stepIndex": 13,
          "note": "Return exchange rate via Fetch latest exchange rate for payment",
          "statusCode": 200
        },
        {
          "id": "step-15",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-checkout",
          "stepIndex": 14,
          "note": "[Success] Payment confirmation via Make payment after checkout",
          "statusCode": 200
        },
        {
          "id": "step-16",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-email",
          "stepIndex": 15,
          "note": "[Success] Create automated email confirmation to customer via Confirm order has been placed",
          "endpoint": "hipstershop.EmailService/SendOrderConfirmation",
          "httpMethod": "gRPC"
        },
        {
          "id": "step-17",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-email-cust",
          "stepIndex": 16,
          "note": "[Success] Send confirmation email via Email",
          "actorAction": "Delivers receipt to customer inbox"
        },
        {
          "id": "step-18",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-front",
          "stepIndex": 17,
          "note": "[Success] Payment and order confirmation message via Start checkout process for product",
          "statusCode": 200
        },
        {
          "id": "step-19",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-front-cust",
          "stepIndex": 18,
          "note": "[Success] Confirm user purchase via Real user traffic",
          "statusCode": 200,
          "actorAction": "Displays Order Success confirmation page"
        },
        {
          "id": "step-20",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-checkout",
          "stepIndex": 19,
          "note": "[Failed] Payment unsuccessful message via Make payment after checkout",
          "statusCode": 402
        },
        {
          "id": "step-21",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-front",
          "stepIndex": 20,
          "note": "[Failed] Payment failed via Start checkout process for product",
          "statusCode": 402
        },
        {
          "id": "step-22",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-front-cust",
          "stepIndex": 21,
          "note": "[Failed] Payment unsuccessful message via Real user traffic",
          "statusCode": 402,
          "actorAction": "Displays payment declined notification and prompts retry"
        },
        {
          "id": "step-23",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-self",
          "stepIndex": 22,
          "note": "[Timeout] Payment timeout (2 mins)",
          "statusCode": 504
        },
        {
          "id": "step-24",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-self",
          "stepIndex": 23,
          "note": "[Timeout] Retry payment gateway transaction"
        },
        {
          "id": "step-25",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-payment-checkout",
          "stepIndex": 24,
          "note": "[Timeout] Payment timeout via Make payment after checkout",
          "statusCode": 504
        },
        {
          "id": "step-26",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-checkout-front",
          "stepIndex": 25,
          "note": "[Timeout] Payment timeout via Start checkout process for product",
          "statusCode": 504
        },
        {
          "id": "step-27",
          "flowId": "flow-user-purchase",
          "connectionId": "conn-front-cust",
          "stepIndex": 26,
          "note": "[Timeout] Payment timeout via Real user traffic",
          "statusCode": 504,
          "actorAction": "Notifies customer of payment processing delay and status check"
        }
      ],
      "createdAt": "2026-01-01T00:00:00.000Z",
      "updatedAt": "2026-01-01T00:00:00.000Z"
    },
    {
