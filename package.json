{
  "name": "diagramhq",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm build:domain && pnpm -r --parallel --if-present dev",
    "docker:watch": "docker compose up --watch",
    "docker:up": "docker compose up -d --build",
    "build": "pnpm -r --if-present build",
    "build:domain": "pnpm --filter @diagramhq/domain build",
    "prisma:generate": "pnpm --filter @diagramhq/api prisma:generate",
    "db:migrate": "pnpm --filter @diagramhq/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @diagramhq/api prisma:seed",
    "smoke": "./scripts/smoke-test.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @diagramhq/web test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-architecture": "./scripts/check-architecture.sh",
    "verify": "pnpm prisma:generate && pnpm build:domain && pnpm typecheck && pnpm lint && pnpm test && pnpm check-architecture"
  },
  "devDependencies": {
    "@diagramhq/config": "workspace:*",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
